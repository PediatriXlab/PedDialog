# LLM API configuration
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# For de-identification screening (Stage 1: automated PII screening).
# The paper describes using Qwen3-30B-A3B-Instruct-250720 deployed on local
# infrastructure.  When running llm_pii_screen.py, configure accordingly:
#
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=Qwen3-30B-A3B-Instruct-250720
#   LLM_API_KEY=not-needed
